{
  "name": "proparty-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply proparty-management --local",
    "db:remote": "wrangler d1 migrations apply proparty-management --remote",
    "test:integration": "npm run build && npm run db:local && node tests/run-integration.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@fontsource-variable/dm-sans": "5.3.0",
    "astro": "7.3.5",
    "lit-html": "^3.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
