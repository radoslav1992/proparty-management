---
// Small, decorative previews of real workspace screens for the landing page's feature cards.
// Figures match the demo workspace. Sizes are in em, and 1em is a tenth of the card's width
// over 40.8, so each preview scales with its card. Screen readers skip them; the card's own
// heading and text describe the feature.
interface Props {
  kind: "rent" | "repairs" | "lease" | "cashflow" | "assistant";
}
const { kind } = Astro.props;
// Six months of the demo: rent collected and expenses, as a share of the busiest month.
const months = [
  [100, 12],
  [100, 11],
  [100, 10],
  [100, 9],
  [100, 8],
  [79, 7],
];
---

<div class:list={["mock", kind]} aria-hidden="true">
  {kind === "rent" && (
    <div class="card">
      <div class="head">
        <strong>Rent ledger</strong>
        <span>This month</span>
      </div>
      <div class="row">
        <div>
          <strong>The Parkside Apartment</strong>
          <small>Elena Petrova</small>
        </div>
        <span class="money">€850.00</span>
        <span class="pill green">paid</span>
      </div>
      <div class="row">
        <div>
          <strong>Lozenets Garden Home</strong>
          <small>Daniel Ivanov · €800 of €1,250</small>
        </div>
        <span class="money">€450.00</span>
        <span class="pill amber">partial</span>
      </div>
      <div class="total">
        <span>Outstanding</span>
        <strong>€450.00</strong>
      </div>
    </div>
  )}
  {kind === "repairs" && (
    <>
      <div class="card issue">
        <div class="pills">
          <span class="pill red">urgent</span>
          <span class="pill">open</span>
        </div>
        <strong>Kitchen tap needs attention</strong>
        <small>The Parkside Apartment · reported today</small>
      </div>
      <div class="card issue shifted">
        <div class="pills">
          <span class="pill">normal</span>
          <span class="pill amber">in progress</span>
        </div>
        <strong>Annual boiler service</strong>
        <small>Lozenets Garden Home · Heating contractor</small>
      </div>
    </>
  )}
  {kind === "lease" && (
    <div class="card">
      <div class="head">
        <strong>The Parkside Apartment</strong>
        <span class="pill green">active</span>
      </div>
      <small class="tenant">Elena Petrova</small>
      <div class="facts">
        <div>
          <small>Term</small>
          <strong>1 Jan – 31 Dec</strong>
        </div>
        <div>
          <small>Rent</small>
          <strong>€850 / month</strong>
        </div>
        <div>
          <small>Deposit</small>
          <strong>€850 held</strong>
        </div>
      </div>
      <div class="file">
        <span class="file-icon">PDF</span>
        <div>
          <strong>Lease agreement.pdf</strong>
          <small>Private · 1.2 MB</small>
        </div>
      </div>
    </div>
  )}
  {kind === "cashflow" && (
    <>
      <div class="net">
        <small>Net this month</small>
        <strong>€1,510.00</strong>
      </div>
      <div class="bars">
        {months.map(([rent, spent]) => (
          <div>
            <span class="bar rent" style={`height:${rent}%`} />
            <span class="bar spent" style={`height:${spent}%`} />
          </div>
        ))}
      </div>
      <div class="legend">
        <span>
          <i class="dot rent" />
          Rent collected
        </span>
        <span>
          <i class="dot spent" />
          Expenses
        </span>
      </div>
    </>
  )}
  {kind === "assistant" && (
    <>
      <div class="bubble user">Who still owes rent this month?</div>
      <div class="bubble ai">
        <span class="ai-name">✧ Proparty assistant</span>
        <strong>Daniel Ivanov</strong> owes <strong>€450.00</strong> for
        Lozenets Garden Home. Shall I draft a friendly reminder?
      </div>
    </>
  )}
</div>

<style>
  .mock {
    aspect-ratio: 4 / 3;
    font-size: calc(100cqw / 40.8);
    padding: 2.6em;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.2em;
    color: var(--ink);
    line-height: 1.3;
    transition: transform 0.5s;
  }
  .mock.rent {
    background: var(--lime);
  }
  .mock.repairs {
    background: #8fe3ea;
  }
  .mock.lease {
    background: #e2dcfb;
  }
  .mock.cashflow {
    background: var(--ink);
    color: white;
  }
  .mock.assistant {
    background: #ffe0cb;
  }
  strong {
    font-weight: 600;
  }
  small {
    display: block;
    color: var(--muted);
    font-size: 1.05em;
    margin-top: 0.2em;
  }
  .card {
    background: white;
    border-radius: 1.4em;
    padding: 1.5em 1.6em;
    box-shadow: 0 1em 2.8em #18302a1f;
    font-size: 1.25em;
  }
  .card small {
    font-size: 0.85em;
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1em;
    margin-bottom: 0.4em;
  }
  .head > span:not(.pill) {
    font-size: 0.85em;
    color: var(--muted);
  }
  .pill {
    display: inline-block;
    font-size: 0.75em;
    padding: 0.35em 0.75em;
    border-radius: 2em;
    background: #eef2e9;
    color: #687568;
    white-space: nowrap;
  }
  .pill.green {
    background: #e2f3d9;
    color: #3d6437;
  }
  .pill.amber {
    background: #fff1ce;
    color: #8d6a19;
  }
  .pill.red {
    background: #fce7e2;
    color: #a63d2d;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr auto 4.6em;
    align-items: center;
    gap: 0.8em;
    padding: 0.8em 0;
    border-top: 1px solid var(--line);
  }
  .row .pill {
    justify-self: end;
  }
  .money {
    font-size: 0.95em;
  }
  .total {
    display: flex;
    justify-content: space-between;
    padding-top: 0.8em;
    border-top: 1px solid var(--line);
    font-size: 0.95em;
  }
  .issue strong {
    display: block;
    margin-top: 0.6em;
  }
  .pills {
    display: flex;
    gap: 0.4em;
  }
  .shifted {
    margin-left: 2.4em;
    margin-right: -1.2em;
  }
  .tenant {
    margin: -0.2em 0 0.9em;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6em;
  }
  .facts div {
    background: var(--soft);
    border-radius: 0.7em;
    padding: 0.6em 0.7em;
  }
  .facts small {
    margin: 0 0 0.2em;
  }
  .facts strong {
    font-size: 0.85em;
  }
  .file {
    display: flex;
    align-items: center;
    gap: 0.8em;
    margin-top: 0.9em;
    padding-top: 0.9em;
    border-top: 1px solid var(--line);
  }
  .file strong {
    font-size: 0.9em;
  }
  .file-icon {
    font-size: 0.65em;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--danger);
    background: #fbe9e5;
    border-radius: 0.6em;
    padding: 1em 0.8em;
  }
  .net small {
    color: #bdc9c1;
    font-size: 1.2em;
  }
  .net strong {
    font-size: 2.8em;
    letter-spacing: -0.02em;
  }
  .bars {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.2em;
    align-items: end;
    border-bottom: 1px solid #ffffff2b;
    padding-bottom: 0.2em;
  }
  .bars div {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0.3em;
    height: 100%;
  }
  .bar {
    width: 1.7em;
    border-radius: 0.4em 0.4em 0 0;
  }
  .bar.rent,
  .dot.rent {
    background: var(--lime);
  }
  .bar.spent,
  .dot.spent {
    background: #ffffff66;
  }
  .legend {
    display: flex;
    gap: 1.6em;
    font-size: 1.1em;
    color: #bdc9c1;
  }
  .dot {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    border-radius: 50%;
    margin-right: 0.4em;
  }
  .bubble {
    font-size: 1.3em;
    padding: 1em 1.2em;
    border-radius: 1.2em;
    max-width: 85%;
    box-shadow: 0 1em 2.8em #5a2f101a;
  }
  .bubble.user {
    align-self: flex-end;
    background: var(--ink);
    color: white;
    border-bottom-right-radius: 0.3em;
  }
  .bubble.ai {
    background: white;
    border-bottom-left-radius: 0.3em;
  }
  .ai-name {
    display: block;
    font-size: 0.8em;
    color: var(--green);
    font-weight: 600;
    margin-bottom: 0.4em;
  }
</style>
