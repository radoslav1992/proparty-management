---
import "@fontsource-variable/dm-sans";
import "../styles/global.css";
import dmSans from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";
const {
  title = "Proparty — A little less admin. A lot more peace of mind.",
  description = "Manage your properties, tenants, rent and maintenance in one calm workspace.",
  app = false,
  motion = false,
  // Public pages get a canonical link and link-preview tags; the workspace and error pages do not.
  share = !app,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.url.origin).href;
const image = new URL("/images/ns-img-223.webp", Astro.url.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#172b26" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preload" href={dmSans} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    {app && <meta name="robots" content="noindex,nofollow" />}
    {share && (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Proparty" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={image} />
        <meta
          property="og:image:alt"
          content="Proparty, a calm workspace for landlords"
        />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <slot name="head" />
  </head>
  <body class:list={{ application: app }}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
    {motion && (
      <>
        <script is:inline src="/vendor/gsap.min.js" defer></script>
        <script is:inline src="/vendor/scroll-trigger.min.js" defer></script>
        <script is:inline src="/vendor/lenis.min.js" defer></script>
        <script is:inline src="/motion.js" defer></script>
      </>
    )}
  </body>
</html>
