{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proparty-management",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proparty-management",
      "database_id": "7f6ae9c1-131c-40f2-838b-c6581c618755",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "PROPERTY_FILES", "bucket_name": "proparty-management-files" },
  ],
  "ai": { "binding": "AI" },
  // Cloudflare Email Service. Nothing is sent until the EMAIL_FROM variable is set (docs/DEPLOYMENT.md).
  "send_email": [{ "name": "EMAIL" }],
  // Daily housekeeping and rent charge generation (src/lib/jobs.ts), 03:17 UTC.
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true },
}
